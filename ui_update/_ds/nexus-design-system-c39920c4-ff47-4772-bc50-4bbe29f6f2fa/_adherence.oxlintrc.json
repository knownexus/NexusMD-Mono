{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cardinal|Cinzel|Crimson Pro|Inter|Cinzel Decorative|Gentium Plus|Cormorant Garamond|Spectral))/i]",
        "message": "Font not provided by the design system. Available: Cardinal, Cinzel, Crimson Pro, Inter, Cinzel Decorative, Gentium Plus, Cormorant Garamond, Spectral."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-border-glow",
      "--accent-bright",
      "--accent-dim",
      "--accent-glow",
      "--accent-initial",
      "--accent-mid",
      "--accent-muted",
      "--accent-text",
      "--border",
      "--border-subtle",
      "--card-bg",
      "--card-raised",
      "--container-bg",
      "--container-hover",
      "--container-raised",
      "--danger",
      "--danger-bg",
      "--ease",
      "--font-body",
      "--font-brand",
      "--font-display",
      "--font-heading",
      "--font-ui",
      "--info",
      "--info-bg",
      "--modal-bg",
      "--nav-bg",
      "--page-bg",
      "--pattern-opacity",
      "--pattern-url",
      "--radius",
      "--radius-lg",
      "--radius-pill",
      "--radius-sm",
      "--radius-xl",
      "--shadow-accent",
      "--shadow-card-hover",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--success",
      "--success-bg",
      "--t-base",
      "--t-fast",
      "--t-slow",
      "--text",
      "--text-bright",
      "--text-dim",
      "--text-muted",
      "--warning",
