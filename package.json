{
  "name": "nexusmd",
  "private": true,
  "version": "1.0.0",
  "description": "NexusMD monorepo — shared core + platform apps (web, desktop, mobile)",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:affected": "node scripts/test-scope.mjs",
    "test:git": "node scripts/test-scope.mjs git",
    "test:devenv": "node scripts/test-scope.mjs devenv",
    "test:database": "node scripts/test-scope.mjs database",
    "test:api-client": "node scripts/test-scope.mjs api-client",
    "test:work": "node scripts/test-scope.mjs work",
    "test:git:full": "node scripts/test-scope.mjs git --full",
    "test:e2e:web": "npm -w apps/web run e2e",
    "test:e2e:desktop": "npm -w apps/desktop run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "electron": "43.0.0",
    "jsdom": "^25.0.0",
    "vite": "8.1.1",
    "vitest": "^4.1.9"
  }
}
