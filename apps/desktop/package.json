{
  "name": "@nexusmd/desktop",
  "private": true,
  "version": "1.2.24",
  "description": "NexusMD desktop app — Electron shell with renderer built by Vite",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Knownexus",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "start": "electron .",
    "icons": "node scripts/create-icons.js",
    "graph:smoke": "node scripts/graph-smoke-test.js",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder --publish never",
    "build:win": "node installer/build-win.mjs --publish onTagOrDraft",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "build:split": "node build/build-split.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@nexusmd/app-api-client": "*",
    "@nexusmd/app-calendar": "*",
    "@nexusmd/app-database": "*",
    "@nexusmd/app-devenv": "*",
    "@nexusmd/app-documents": "*",
    "@nexusmd/app-editor": "*",
    "@nexusmd/app-git": "*",
    "@nexusmd/app-notes": "*",
    "@nexusmd/app-planner": "*",
    "@nexusmd/app-work": "*",
    "@nexusmd/core": "*",
    "@nexusmd/editor-kit": "*",
    "@nexusmd/main-kit": "*",
    "@nexusmd/shell-sdk": "*",
    "@nexusmd/ui": "*",
    "@nexusmd/web-adapters": "*",
    "codemirror": "^6.0.2",
    "electron-log": "^5.0.0",
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "vite": "^8.1.1",
    "vitest": "4.1.9"
  },
  "build": {
    "appId": "com.knownexus.nexusmd",
    "productName": "NexusMD",
    "icon": "assets/icon",
    "directories": {
      "output": "../../dist/desktop/release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/@nexusmd/app-git/src/main/git-editor.cjs"
    ],
    "extraResources": [
      {
        "from": "../../dist/desktop/renderer",
        "to": "renderer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "executableName": "nexusmd"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "knownexus",
      "repo": "NexusMD-Mono",
      "releaseType": "draft"
    }
  }
}
