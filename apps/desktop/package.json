{
  "name": "@nexusmd/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "NexusMD desktop app — Electron shell with renderer built by Vite",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Knownexus",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "e2e": "vite build && playwright test",
    "start": "electron .",
    "icons": "node scripts/create-icons.js",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@nexusmd/core": "*",
    "@nexusmd/ui": "*",
    "@nexusmd/web-adapters": "*",
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "vite": "^8.1.1",
    "vitest": "4.1.9"
  },
  "build": {
    "appId": "com.knownexus.nexusmd",
    "productName": "NexusMD",
    "icon": "assets/icon",
    "directories": {
      "output": "../../dist/desktop/release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../../dist/desktop/renderer",
        "to": "renderer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Knownexus",
      "repo": "NexusMD-Desktop"
    }
  }
}
