{
  "Ado": {
    "Organisation": "my-org",
    "TimeoutSeconds": 120,
    "Projects": [
      "ExampleAPI",
      "ExampleNucleus",
      "ExampleBxIn",
      "ExamplePortal"
    ],
    "TestProject": "AutomatedTests",
